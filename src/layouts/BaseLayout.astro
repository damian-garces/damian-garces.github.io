---
import "../styles/global.css";
import { locales, defaultLocale, type Locale } from "../i18n/ui";
import { localizedPath } from "../i18n/utils";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path relative to the locale root, e.g. "/" — used to build hreflang alternates. */
  path?: string;
}

const { locale, title, description, path = "/" } = Astro.props;
const canonicalUrl = new URL(localizedPath(locale, path), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0A0B" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={new URL(localizedPath(loc, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(defaultLocale, path), Astro.site)} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
