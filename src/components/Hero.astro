---
import CodeEditor from "./islands/CodeEditor.tsx";
import { getHighlightedSnippets } from "../lib/shiki";
import { buildAllRibbons } from "../lib/wavePaths";
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

interface HeroMetaItem {
  key: string;
  value: string;
}

interface Props {
  locale: Locale;
  name: string;
  role: string;
  tagline: string;
  heroMeta: HeroMetaItem[];
  cvUrl: string;
}

const { locale, name, role, tagline, heroMeta, cvUrl } = Astro.props;
const t = useTranslations(locale);
const [firstName, ...restName] = name.split(" ");
const snippets = await getHighlightedSnippets();
const ribbons = buildAllRibbons();
---

<header id="top" class="hero">
  <svg
    class="wave-svg"
    viewBox="0 0 1400 700"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="dgW1" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--wave-c1)"></stop>
        <stop offset="55%" stop-color="var(--wave-c2)"></stop>
        <stop offset="100%" stop-color="var(--wave-c3)"></stop>
      </linearGradient>
      <linearGradient id="dgW2" x1="1" y1="0" x2="0" y2="0">
        <stop offset="0%" stop-color="var(--wave-c3)"></stop>
        <stop offset="50%" stop-color="var(--wave-c4)"></stop>
        <stop offset="100%" stop-color="var(--wave-c2)"></stop>
      </linearGradient>
      <filter id="dgWBlur" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="4"></feGaussianBlur>
      </filter>
    </defs>
    {
      ribbons.map((rb, ri) => (
        <g class="wave-group" data-wave-anim={ri === 0 ? "a" : ri === 1 ? "b" : "a-reverse"}>
          <path d={rb.glowD} fill="none" stroke={`url(#${rb.gradId})`} stroke-width="10" opacity="0.32" filter="url(#dgWBlur)" />
          {rb.lines.map((line) => (
            <path d={line.d} fill="none" stroke={`url(#${rb.gradId})`} stroke-width={line.width} opacity={line.opacity} />
          ))}
        </g>
      ))
    }
  </svg>
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="eyebrow" data-reveal="1">
        <span class="pulse-dot"></span>
        {role}
      </div>
      <h1 class="headline" data-reveal="1">
        {firstName}<br />{restName.join(" ")}<span class="accent">.</span>
      </h1>
      <p class="tagline" data-reveal="1">{tagline}</p>
      <div class="cta-row" data-reveal="1">
        <a href="#work" class="btn btn-primary" data-magnetic="1">
          {t("nav.viewWork")} <span class="mono">→</span>
        </a>
        <a href={cvUrl} download class="btn btn-outline" data-magnetic="1">
          {t("nav.downloadCv")} <span class="mono accent-text">↓</span>
        </a>
      </div>
      <div class="hero-meta" data-reveal="1">
        {
          heroMeta.map((m) => (
            <div class="meta-item">
              <span class="meta-key">{m.key}</span>
              <span class="meta-value">{m.value}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hero-editor" data-reveal="1">
      <CodeEditor client:visible snippets={snippets} idleConsoleText="$ ready" ranConsoleText="> build(idea) ⟶ Product { shipped: true } ✓" />
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .wave-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--wave-opacity);
    pointer-events: none;
    z-index: 0;
  }
  .wave-group {
    transform-origin: 700px 350px;
  }
  /*
   * The source design drives these ribbons with a per-frame JS loop that
   * recomputes each line's sine path — the group transform below was only
   * ever a subtle accent on top of that. Ported at the original's 20-30s
   * durations, that accent alone reads as nearly frozen, since it's now
   * carrying the entire motion on its own. Sped up ~4x here so the ribbons
   * actually read as flowing while staying pure CSS (no per-frame JS).
   */
  .wave-group[data-wave-anim="a"] {
    animation: dg-waveA 5s ease-in-out infinite;
  }
  .wave-group[data-wave-anim="b"] {
    animation: dg-waveB 6.5s ease-in-out infinite;
  }
  .wave-group[data-wave-anim="a-reverse"] {
    animation: dg-waveA 8s ease-in-out infinite reverse;
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-group {
      animation: none !important;
    }
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(48px, 10vh, 120px) clamp(18px, 5vw, 48px) clamp(40px, 7vh, 80px);
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-copy {
    flex: 1 1 480px;
    min-width: 280px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: clamp(20px, 3vw, 30px);
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: dg-pulse 2.4s ease-in-out infinite;
  }
  .headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 6.6vw, 100px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    color: var(--text);
    text-wrap: balance;
  }
  .accent {
    color: var(--accent-text);
  }
  .tagline {
    margin: clamp(24px, 3.5vw, 38px) 0 0;
    max-width: 560px;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--dim);
    text-wrap: pretty;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: clamp(28px, 4vw, 40px);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 11px;
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .btn-outline {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border-strong);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .accent-text {
    color: var(--accent-text);
  }
  .hero-meta {
    display: flex;
    gap: clamp(20px, 4vw, 52px);
    flex-wrap: wrap;
    margin-top: clamp(44px, 6vw, 72px);
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .meta-key {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .meta-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    color: var(--text);
  }
  .hero-editor {
    flex: 1 1 460px;
    min-width: 300px;
    max-width: 560px;
    margin-left: auto;
  }
</style>
