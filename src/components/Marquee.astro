---
interface Props {
  items: string[];
}

const { items } = Astro.props;
// Duplicated once so the CSS marquee animation (-50% translate) loops seamlessly.
const track = [...items, ...items];
---

<div class="marquee-wrap">
  <div class="marquee-frame">
    <div data-marquee-track="1" class="marquee-track">
      {
        track.map((item) => (
          <span class="marquee-item">
            {item} <span class="diamond">◆</span>
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .marquee-wrap {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 clamp(18px, 5vw, 48px);
  }
  .marquee-frame {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    padding: 18px 0 18px 28px;
    background: var(--surface);
    border-radius: 14px;
  }
  .marquee-track {
    display: flex;
    width: max-content;
  }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    padding: 0 26px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--dim);
    white-space: nowrap;
  }
  .diamond {
    color: var(--accent-text);
    opacity: 0.7;
  }
</style>
