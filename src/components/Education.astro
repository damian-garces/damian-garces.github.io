---
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

interface EducationItem {
  n: string;
  year: string;
  title: string;
  place: string;
  certificateUrl?: string;
}
interface Heading {
  eyebrow: string;
  title: string;
  note: string;
}

interface Props {
  n: string;
  heading: Heading;
  items: EducationItem[];
  certificateLabel: string;
}

const { n, heading, items, certificateLabel } = Astro.props;
---

<Section id="education">
  <SectionHeading n={n} eyebrow={heading.eyebrow} title={heading.title} note={heading.note} />
  <div class="rows">
    {
      items.map((item) => (
        <div class="row" data-reveal="1">
          <div class="row-meta">
            <span class="index mono">{item.n}</span>
            <span class="year mono">{item.year}</span>
          </div>
          <div class="row-body">
            <h3>{item.title}</h3>
            <div class="place">{item.place}</div>
          </div>
          {item.certificateUrl && (
            <a href={item.certificateUrl} target="_blank" rel="noopener noreferrer" class="cert-link mono">
              {certificateLabel} ↗
            </a>
          )}
        </div>
      ))
    }
  </div>
</Section>

<style>
  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    gap: clamp(16px, 3vw, 40px);
    padding: 22px 0;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .row-meta {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 120px;
  }
  .mono {
    font-family: var(--font-mono);
  }
  .index {
    font-size: 13px;
    color: var(--accent-text);
  }
  .year {
    font-size: 12px;
    color: var(--faint);
  }
  .row-body {
    flex: 1 1 280px;
  }
  h3 {
    margin: 0 0 5px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .place {
    font-size: 14px;
    color: var(--dim);
  }
  .cert-link {
    flex: 0 0 auto;
    align-self: center;
    text-decoration: none;
    color: var(--text);
    font-size: 12px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 8px 13px;
  }
</style>
